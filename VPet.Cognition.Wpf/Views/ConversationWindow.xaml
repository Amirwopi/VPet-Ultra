<pu:WindowX x:Class="VPet.Cognition.Wpf.Views.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        xmlns:vm="clr-namespace:VPet.Cognition.Wpf.ViewModels"
        xmlns:conv="clr-namespace:VPet.Cognition.Wpf.Converters"
        Title="VPet Chat" Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowXCaption.Height="0"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#1E1E2E"
        Foreground="#E0E0E0">
    <pu:WindowX.Resources>
        <conv:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter" />
        <conv:BoolToBubbleConverter x:Key="BoolToBubbleConverter" />
    </pu:WindowX.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Message list -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatMessageVm}">
                        <Border Margin="0,3"
                                Padding="10,6"
                                CornerRadius="12"
                                HorizontalAlignment="{Binding IsUser, Converter={StaticResource BoolToAlignmentConverter}}"
                                Background="{Binding IsUser, Converter={StaticResource BoolToBubbleConverter}}">
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" MaxWidth="350" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input bar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="InputBox_KeyDown"
                     pu:TextBoxHelper.Watermark="Type a message..."
                     Padding="8,6"
                     Background="#2A2A3C"
                     Foreground="#E0E0E0"
                     BorderBrush="#3D3D5C" />

            <Button Grid.Column="1" Margin="5,0,0,0"
                    Content="Send"
                    Command="{Binding SendCommand}"
                    Padding="15,6"
                    Background="#7B68EE"
                    Foreground="White"
                    BorderThickness="0" />

            <Button Grid.Column="2" Margin="5,0,0,0"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="10,6"
                    Background="#E57373"
                    Foreground="White"
                    BorderThickness="0" />
        </Grid>
    </Grid>
</pu:WindowX>