<pu:WindowX x:Class="VPet_Simulator.Windows.winCharacterPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:local="clr-namespace:VPet_Simulator.Windows" Foreground="{StaticResource PrimaryText}"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pu="https://opensource.panuon.com/wpf-ui" Title="Status"
        Width="{ll:Dbe CharacterPanelWidth_500, DefValue=500}" Height="{ll:Dbe CharacterPanelHeight_500, DefValue=500}"
        Style="{DynamicResource BaseWindowXStyle}" WindowStartupLocation="CenterScreen" mc:Ignorable="d"
        Closed="WindowX_Closed">
    <Window.Resources>
        <Style x:Key="DataGridTextColumnCenterSytle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DataGridTextColumnLeftSytle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <TabControl x:Name="MainTab" Grid.Column="1" Margin="5" pu:TabControlHelper.CanHeaderPanelScroll="True"
            pu:TabControlHelper.ItemsCornerRadius="4" pu:TabControlHelper.ItemsHeight="NaN"
            pu:TabControlHelper.ItemsHoverBackground="{DynamicResource PrimaryLight}"
            pu:TabControlHelper.ItemsPadding="10,7"
            pu:TabControlHelper.ItemsSelectedBackground="{DynamicResource PrimaryDark}"
            pu:TabControlHelper.ItemsSelectedForeground="{DynamicResource DARKPrimaryText}" Background="Transparent"
            BorderThickness="0" Foreground="{DynamicResource PrimaryText}" SelectedIndex="0"
            SelectionChanged="MainTab_SelectionChanged">
        <TabControl.ContentTemplate>
            <DataTemplate>
                <Border Margin="0,5,0,5" Background="{DynamicResource DARKPrimaryText}" CornerRadius="15">
                    <ContentControl Margin="0,0" Content="{Binding}" />
                </Border>
            </DataTemplate>
        </TabControl.ContentTemplate>
        <TabItem Header="{ll:Str Statistics Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="TextBox_Search" pu:TextBoxHelper.Watermark="{ll:Str Search Statistics}"
                        Style="{DynamicResource StandardTextBoxStyle}" TextChanged="TextBox_Search_TextChanged" />
                <DataGrid x:Name="DataGridStatic" Grid.Row="1" Margin="0,5,0,0"
                        d:ItemsSource="{d:SampleData ItemCount=5}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding StatId}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding StatName}"
                                ElementStyle="{StaticResource DataGridTextColumnLeftSytle}" Header="{ll:Str Name}"
                                IsReadOnly="True" Width="300">
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding StatCount}"
                                ElementStyle="{StaticResource DataGridTextColumnCenterSytle}" Header="{ll:Str Quantity}"
                                IsReadOnly="True" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

        </TabItem>
        <TabItem Header="{ll:Str Stats Summary}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="btn_r_genRank" Grid.Column="1" pu:ButtonHelper.CornerRadius="4"
                        Background="{DynamicResource SecondaryLight}" BorderBrush="{DynamicResource SecondaryDark}"
                        BorderThickness="2" Content="{ll:Str Generate stats}" Margin="5,2" Click="btn_r_genRank_Click" />
                <Button x:Name="btn_r_save" Grid.Column="1" pu:ButtonHelper.CornerRadius="4"
                        Background="{DynamicResource SecondaryLight}" BorderBrush="{DynamicResource SecondaryDark}"
                        BorderThickness="2" Content="{ll:Str Save image}" Margin="5,2" Grid.Row="1" Click="btn_r_save_Click"
                        IsEnabled="False" />
                <CheckBox x:Name="cb_NoCheat" Content="{ll:Str 'Have not used any cheat mods or modified game stats.'}" Margin="5,2"
                        BorderBrush="{DynamicResource DARKPrimary}" pu:CheckBoxHelper.CornerRadius="4" IsEnabled="False"
                        Unchecked="cb_NoCheat_Unchecked" />
                <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" x:Name="r_viewbox" Visibility="Collapsed">
                    <Viewbox x:Name="r_output">
                        <Grid x:Name="r_output_base">
                            <Image Source="/Res/img/rbgt.png" VerticalAlignment="Top" Stretch="UniformToFill" />
                            <Image Source="/Res/img/rbgb.png" VerticalAlignment="Bottom" Stretch="UniformToFill" />
                            <Grid Margin="55,310,55,55">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="110" />
                                    <RowDefinition Height="160" />
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="160" />
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="160" />
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="160" />
                                    <RowDefinition Height="200" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <Image Source="/Res/img/rank1.png" Grid.Row="1" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="10,0,10,0" FontSize="16" Grid.Row="1">
                                <Run x:Name="r_r_startday" Text="XXXXXXXX" FontSize="24" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /><LineBreak />
                                <Run Text="{ll:Str Your first encounter with this cute little thing}" /><LineBreak />
                                <Run Text="{ll:Str 'First encounter, master~'}" />
                                </TextBlock>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="2" FontSize="16" MaxWidth="500" TextWrapping="Wrap"
                                        Grid.ColumnSpan="2">
                                <Run Text="{ll:Str You and }" /><Run x:Name="r_r_petname_2" Text="Lolis" /><Run
                                            Text="{ll:Str  lived together for}" /> <Run x:Name="r_r_startlength" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str Days}" /><LineBreak />
                                <Run Text="{ll:Str The length of time you stayed with her was}" /> <Run x:Name="r_r_length_h" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str Hours.}" /><LineBreak />
                                <Run Text="{ll:Str More than}" /> <Run x:Name="r_r_length_p" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str &quot;of the world's players&quot;}" /><LineBreak />
                                <Run x:Name="r_r_lenghranktext" Text="Master, thank you for your company." FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" />
                                </TextBlock>

                                <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="3" FontSize="16" MaxWidth="300" TextWrapping="Wrap">
                                 <Run Text="{ll:Str Spend an average of}" /> <Run x:Name="r_r_lengthph" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str hours a day together.}" /><LineBreak />
                                 <Run Text="{ll:Str Equivalent to the average time spent with}" /> <Run x:Name="r_r_lengthphtext" Text="Classmates"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str time spent together}" /><LineBreak />
                                 <Run x:Name="r_r_lenghtext" Text="~"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_timelength" Source="/Res/img/r_timelength_1.png" Grid.Row="3"
                                        Grid.Column="1" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="4" FontSize="16" MaxWidth="350" TextWrapping="Wrap">
                                <Run Text="{ll:Str Your Level is}" /> <Run x:Name="r_r_level" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str }" /><LineBreak />
                                <Run Text="{ll:Str Cumulative experience gained}" /> <Run x:Name="r_r_exp" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /><LineBreak />
                                <Run Text="{ll:Str The cumulative learning time is}" /> <Run x:Name="r_r_studytime" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str minutes}" /><LineBreak />
                               <Run x:Name="r_r_studytext" Text="Equivalent to elementary school education&#13;&quot;Purge! Lolis's Requiem&quot;"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_exp" Source="/Res/img/r_level_1.png" Grid.Row="4" />
                                <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="5" FontSize="16" MaxWidth="300" TextWrapping="Wrap">
                             <Run Text="{ll:Str Maximum single learning gain}" /> <Run x:Name="r_r_studyexpmax" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str EXP}" /><LineBreak />
                             <Run Text="{ll:Str More than}" /> <Run x:Name="r_r_studyexpmaxrank" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str &quot;of the world's players&quot;}" /><LineBreak />
                             <Run x:Name="r_r_studyexptext" Text="Look at my quantum speed reading method!"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_singleexp" Source="/Res/img/r_singleexp_1.png" Grid.Row="5"
                                        Grid.Column="1" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="6" FontSize="16" MaxWidth="350" TextWrapping="Wrap">
                                <Run Text="{ll:Str Cumulative Work time is}" /> <Run x:Name="r_r_worktime" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str minutes}" /><LineBreak />
                                <Run Text="{ll:Str Work accounts for of total time}" /> <Run x:Name="r_r_worktimeps" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /><LineBreak />
                                <Run Text="{ll:Str More than}" /> <Run x:Name="r_r_worktimepsrank" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str &quot;of the world's players&quot;}" /><LineBreak />
                               <Run x:Name="r_r_worktext" Text="“，”"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_money" Source="/Res/img/r_worktime_1.png" Grid.Row="6" />
                                <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="7" FontSize="16" MaxWidth="300" TextWrapping="Wrap">
                                 <Run Text="{ll:Str Maximum acquisition of Work in a single session}" /> <Run x:Name="r_r_workmoneymax" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str Money}" /><LineBreak />
                                 <Run Text="{ll:Str More than}" /> <Run x:Name="r_r_workmoneyrank" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str &quot;of the world's players&quot;}" /><LineBreak />
                                 <Run x:Name="r_r_workmoneytext" Text="But I really need that money!"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_singlemoney" Source="/Res/img/r_singlemoney_1.png" Grid.Row="7"
                                        HorizontalAlignment="Left" Grid.Column="1" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="8" FontSize="16" MaxWidth="350" TextWrapping="Wrap">
                                 <Run Text="{ll:Str Accumulated}" /> <Run x:Name="r_r_betterbuytimes" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str times purchases of better products}" /><LineBreak />
                                 <Run Text="{ll:Str Accumulated Spend}" /> <Run x:Name="r_r_betterbuycount" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str Money}" /><LineBreak />
                                 <Run Text="{ll:Str Among the most purchased are}" /> <Run x:Name="r_r_betterbuymostitem" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str under the category}" /> <Run x:Name="r_r_betterbuymosttype" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /><LineBreak />
                                <Run x:Name="r_r_betterbuymosttext" Text="“Snacking is good for your mental health.”"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_mostfood" Grid.Row="8" Source="/Res/img/r_mostfood_Snack.png" />
                                <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="9" FontSize="16" MaxWidth="500" TextWrapping="Wrap">
                                 <Run Text="{ll:Str Automatic purchases}" /> <Run x:Name="r_r_autobuy" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str times}" /><LineBreak />
                                 <Run Text="{ll:Str of all purchases}" /> <Run x:Name="r_r_autobuypres" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /><LineBreak />
                                 <Run Text="{ll:Str More than}" /> <Run x:Name="r_r_autobuyrank" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str &quot;of the world's players&quot;}" /><LineBreak />
                                 <Run x:Name="r_r_autobuytext" Text="“Don't underestimate my intel network! You didn't turn off auto-purchase gifts, right?”"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_autobuy" Grid.Row="9" Source="/Res/img/r_autobuy_1.png"
                                        Grid.Column="1" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="10,0,10,0" Grid.Row="10" FontSize="16" MaxWidth="350"
                                        TextWrapping="Wrap">
                                   <Run Text="{ll:Str You subscribed to}" /> <Run x:Name="r_r_modcount" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str mods}" /><LineBreak />
                                   <Run Text="{ll:Str of which are enabled}" /> <Run x:Name="r_r_modenablecount" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str mods}" /><LineBreak />
                                   <Run Text="{ll:Str You subscribed to more mods than}" /> <Run x:Name="r_r_modcountrank" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str &quot;of the world's players&quot;}" /><LineBreak />
                                  <Run x:Name="r_r_modcounttext" Text="“Master is already a mod master meow, why not try the mod maker and make mods for me meow”"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_mod" Source="/Res/img/r_mod_1.png" Grid.Row="10" />
                                <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="10" Grid.Row="11" Grid.ColumnSpan="2" FontSize="20" MaxWidth="500"
                                        TextWrapping="Wrap">
                                 <Run Text="{ll:Str Slept}" /> <Run x:Name="r_r_sleeplength" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str hours}" /><LineBreak />
                                 <Run Text="{ll:Str Moved}" /> <Run x:Name="r_r_movelength" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /><Run
                                            x:Name="r_r_movelengthcm" Text="px" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str 'distance'}" /><LineBreak />
                                 <Run Text="{ll:Str Said}" /> <Run x:Name="r_r_saycount" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str 'Sentence'}" /><LineBreak />
                                 <Run Text="{ll:Str Danced}" /> <Run x:Name="r_r_musiccount" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str 'times'}" /><LineBreak />
                                 <Run Text="{ll:Str Touched}" /> <Run x:Name="r_r_touchtotal" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str 'times'}" /><LineBreak />                                 
                                 <Run Text="&quot;" Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" /><Run
                                            Text="{ll:Str 'Eat, drink, play and sleep.'}"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" /><Run
                                            Text="&quot;" Foreground="{DynamicResource DARKPrimaryDarker}"
                                            FontWeight="Bold" />
                                </TextBlock>
                                <Image x:Name="r_i_like" Source="/Res/img/rank2.png" Grid.Row="12" Grid.ColumnSpan="2" />
                                <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="40" Grid.Row="13" Grid.ColumnSpan="2" FontSize="20" MaxWidth="500"
                                        TextWrapping="Wrap">
                                 <Run Text="{ll:Str The number of times the game is opened is}" /> <Run x:Name="r_r_opencount" Text="XX" FontWeight="Bold"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /> <Run Text="{ll:Str times}" /><LineBreak />
                                 <Run Text="{ll:Str The full states of}" /><Run x:Name="r_r_petname_3" Text="Lolis" /><Run
                                            Text="{ll:Str being taken care of}" /> <Run x:Name="r_r_bettercount" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str 'times'}" /><LineBreak /><LineBreak />
                                 <Run x:Name="r_r_petname_4" Text="Lolis" /><Run Text="{ll:Str &quot;'s favorability towards you is&quot;}" /><LineBreak /> <Run
                                            x:Name="r_r_likecount" Text="&#xEE0E;&#xEE0E;&#xEE0E;&#xEE0F;"
                                            FontWeight="Bold"
                                            FontFamily="/VPet-Simulator.Windows;component/Res/#remixicon"
                                            Foreground="{DynamicResource DARKPrimaryDark}" /><LineBreak /><LineBreak />
                                 <Run Text="{ll:Str More than}" /> <Run x:Name="r_r_likecountrank" Text="XX"
                                            FontWeight="Bold" Foreground="{DynamicResource DARKPrimaryDark}" /> <Run
                                            Text="{ll:Str &quot;of the world's players&quot;}" /><LineBreak />                                 
                                 <LineBreak />
                                <Run Text="&quot;" Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" /><Run
                                            Text="{ll:Str &quot;You're my favorite, master. Please take care of me in the new year.&quot;}"
                                            Foreground="{DynamicResource DARKPrimaryDarker}" FontWeight="Bold" /><Run
                                            Text="&quot;" Foreground="{DynamicResource DARKPrimaryDarker}"
                                            FontWeight="Bold" />
                                </TextBlock>
                                <Image Source="/Res/img/rank3.png" Grid.Row="14" Grid.ColumnSpan="2" />
                            </Grid>
                            <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                    Foreground="{DynamicResource DARKPrimaryDarker}" Margin="60,0,0,55"
                                    FontWeight="Bold" FontSize="16">
                                    <Run Text="To" FontSize="20" /> <Run x:Name="r_r_petname" Text="Lolis" FontSize="24" /> <LineBreak />
                                    <Run Text="By" FontSize="20" /> <Run x:Name="r_r_username" Text="LorisYounger"
                                        FontSize="24" /> <LineBreak />
                                    @<Run Text="{ll:Str VPet-Simulator}" /> (<Run x:Name="r_r_now" Text="2023/12/29" />)
                            </TextBlock>
                        </Grid>
                    </Viewbox>
                </ScrollViewer>
                <ProgressBar x:Name="pb_r_genRank" Height="20" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Top"
                        pu:ProgressBarHelper.CornerRadius="4" pu:ProgressBarHelper.IsPercentVisible="True"
                        Background="{DynamicResource SecondaryLighter}" BorderBrush="{DynamicResource SecondaryDark}"
                        BorderThickness="1.5" FontSize="10" Foreground="{DynamicResource Secondary}" Value="0"
                        Margin="0,5,0,0" Visibility="Collapsed" />
            </Grid>
        </TabItem>
        <TabItem x:Name="tab_bday" Header="{ll:Str Birthday Wishes}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{ll:Str From}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                            Margin="20,0,0,0" />
                    <ComboBox x:Name="cb_birthday" Margin="10,5,10,5" Grid.Column="1" FontSize="16"
                            Style="{DynamicResource StandardComboBoxStyle}"
                            SelectionChanged="cb_birthday_SelectionChanged" />
                    <TextBlock x:Name="btn_birthday" Text="{ll:Str &quot;'s Birthday Greetings&quot;}" Grid.Column="2" FontSize="16"
                            FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <pu:Switch Grid.Column="3" Margin="10,0,0,0" Background="Transparent" x:Name="sw_forfriend"
                            BorderBrush="{DynamicResource PrimaryDark}" BoxHeight="18" BoxWidth="35"
                            CheckedBackground="{DynamicResource Primary}" CheckedBorderBrush="{DynamicResource Primary}"
                            CheckedToggleBrush="{DynamicResource DARKPrimaryText}" Content="{ll:Str 'Customized'}"
                            ToggleBrush="{DynamicResource PrimaryDark}" ToggleShadowColor="{x:Null}" ToggleSize="14" />
                    <Button x:Name="btn_b_save" Grid.Column="4" pu:ButtonHelper.CornerRadius="4"
                            Background="{DynamicResource SecondaryLight}" BorderBrush="{DynamicResource SecondaryDark}"
                            BorderThickness="2" Content="{ll:Str Save image}" Grid.Row="1" Margin="5,2,5,2"
                            Click="btn_b_save_Click" />
                </Grid>
                <Grid Grid.Row="1"
                        Visibility="{Binding IsChecked,Converter={x:Static pu:Converters.FalseToCollapseConverter}, ElementName=sw_forfriend}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tb_bdiy" Grid.Column="0" Margin="10,2" FontSize="16"
                            Style="{DynamicResource StandardTextBoxStyle}" AcceptsReturn="True" Text="P cat wishes P cat happy birthday"
                            pu:TextBoxHelper.Watermark="{ll:Str Fill in your customized message!}" />
                    <pu:DateTimePicker x:Name="dtp_bdiy" FontSize="16" BorderBrush="{DynamicResource DARKPrimary}"
                            pu:ShadowHelper.Opacity="0.5" BorderThickness="2" Height="30" Grid.Column="1"
                            Background="{DynamicResource DARKPrimaryText}" Padding="7,0,15,0" CornerRadius="5"
                            SelectedDateTimeChanged="dtp_bdiy_SelectedDateTimeChanged" />
                    <Button x:Name="btn_b_headimage" Grid.Column="2" pu:ButtonHelper.CornerRadius="4"
                            Background="{DynamicResource SecondaryLight}" BorderBrush="{DynamicResource SecondaryDark}"
                            BorderThickness="2" Content="{ll:Str Select avatar Image}" Grid.Row="2" Margin="5,2"
                            Click="btn_b_headimage_Click" />
                </Grid>
                <Border Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox x:Name="b_Output">
                        <Grid Width="300" Height="200">
                            <Image x:Name="img_b_head" Source="/Res/player.png" Width="62" Margin="74,130,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Image x:Name="img_b_background" Stretch="UniformToFill" />
                            <Label x:Name="lb_b_datetime" Content="Shot on VPet - 2023/8/14" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Padding="2,1,2,1" Foreground="White" Background="#a000"
                                    FontSize="10" />
                            <Viewbox x:Name="vb_b_text" Margin="140,100,5,10">
                                <Border x:Name="b_b_text" Background="#ddF9C08A" CornerRadius="5" Padding="3"
                                        MaxWidth="300">
                                    <TextBlock x:Name="tb_b_text" FontWeight="Bold" TextWrapping="WrapWithOverflow"
                                            Text="{Binding Text,ElementName=tb_bdiy}"/>
                                </Border>
                            </Viewbox>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="{ll:Str Activity Log}">
            <TextBox x:Name="tb_log" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Visible" BorderThickness="0"
                    Background="Transparent" Foreground="{DynamicResource DARKPrimaryDarker}" TextWrapping="Wrap"
                    pu:ScrollViewerHelper.MouseWheelUnit="5" HorizontalContentAlignment="Left" />
        </TabItem>
    </TabControl>

</pu:WindowX>