                                <Run Text="{ll:Str Proactively engage in interaction }" /> <Run x:Name="RInter">4</Run> <Run
                                        Text="{ll:Str ' per minute'}" />
                            </TextBlock>
                            <Grid Grid.Row="3" Grid.Column="2" ToolTip="{ll:Str This determines how many computational cycles must elapse until automatic actions are performed again}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="InteractionSlider" VerticalAlignment="Center" IsSnapToTickEnabled="True"
                                        LargeChange="5" Maximum="1000" Minimum="30" SmallChange="1"
