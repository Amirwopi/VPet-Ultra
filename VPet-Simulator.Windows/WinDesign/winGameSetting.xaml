                                            <system:Int32>120</system:Int32>
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{ll:Str '5 minute'}">
                                        <ComboBoxItem.Tag>
                                            <system:Int32>300</system:Int32>
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{ll:Str '10 minute'}">
                                        <ComboBoxItem.Tag>
                                            <system:Int32>600</system:Int32>
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{ll:Str '20 minute'}">
                                        <ComboBoxItem.Tag>
                                            <system:Int32>1200</system:Int32>
                                        </ComboBoxItem.Tag>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{ll:Str '30 minute'}">
