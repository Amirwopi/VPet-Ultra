                                <Button x:Name="BtnSetMoveArea_Window" Grid.Row="2" Grid.Column="2" Margin="5,5,5,5"
                                        Padding="1" pu:ButtonHelper.CornerRadius="4"
                                        Background="{DynamicResource SecondaryLight}"
                                        Click="BtnSetMoveArea_Window_Click" Content="{ll:Str Customize range of movement}"
                                        ToolTip="{ll:Str 'Manually set the range of movement for your favorite'}" />
                            </Grid>
                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{ll:Str Data Calculation}" />
