<pu:WindowX x:Class="VPet_Simulator.Windows.winReport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:VPet_Simulator.Windows"
        xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI" Foreground="{StaticResource PrimaryText}"
        xmlns:system="clr-namespace:System;assembly=mscorlib" mc:Ignorable="d"
        Style="{DynamicResource BaseWindowXStyle}" WindowStartupLocation="CenterScreen" Width="500" MinHeight="250"
        Height="Auto" ResizeMode="NoResize" WindowState="Normal" Icon="../vpeticon.ico" SizeToContent="Height"
        Closed="WindowX_Closed">
    <Grid Margin="10,10,15,10" VerticalAlignment="Top">
        <StackPanel x:Name="MainGrid">
            <Label Background="{x:Null}" VerticalAlignment="Top" HorizontalAlignment="Left" Content="{ll:Str Feedback and Bug submission}"
                    FontSize="24" Margin="10,0,0,0" />
            <pu:FormGroup Header="{ll:Str 'Type'}" HeaderPadding="10,0,10,0" HeaderHeight="20" Orientation="Horizontal"
                    Margin="0,2,0,0" Padding="1" FontSize="16" ToolTip="{ll:Str The type of feedback required}" HeaderWidth="Auto">
                <ComboBox x:Name="tType" SelectedIndex="4" SelectionChanged="tType_SelectionChanged">
                    <ComboBoxItem Content="{ll:Str 'An in-game error is reported'}" />
                    <ComboBoxItem Content="{ll:Str 'Logical calculation error'}" />
                    <ComboBoxItem Content="{ll:Str 'Value design not reasonable'}" />
                    <ComboBoxItem Content="{ll:Str 'Gameplay and feature suggestions'}" />
                    <ComboBoxItem Content="{ll:Str 'Play experience sharing'}" />
                    <ComboBoxItem Content="{ll:Str 'Untranslated Documents Submission'}" />
                    <ComboBoxItem Content="{ll:Str 'Ask Smart Lolis AI a question'}" />
                </ComboBox>
            </pu:FormGroup>
            <pu:FormGroup Header="{ll:Str 'Description'}" HeaderPadding="10,0,10,0" HeaderHeight="20" Orientation="Horizontal"
                    Margin="0,2,0,0" Padding="1" FontSize="16" ToolTip="{ll:Str Detailed description of the feedback}">
                <TextBox x:Name="tDescription" pu:TextBoxHelper.Watermark="{ll:Str 'Detaileddescriptions\&#13;eg:at a time'}"
                        AcceptsReturn="True" MaxHeight="172" />
            </pu:FormGroup>
            <pu:FormGroup Header="{ll:Str 'Content'}" HeaderPadding="10,0,10,0" HeaderHeight="20" Orientation="Horizontal"
                    Margin="0,2,0,0" Padding="1" FontSize="16" ToolTip="{ll:Str Details}">
                <TextBox x:Name="tContent" pu:TextBoxHelper.Watermark="{ll:Str 'Detaileddescriptions\&#13;eg:Detailed'}"
                        AcceptsReturn="True" MaxHeight="172" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto" />
            </pu:FormGroup>
            <pu:FormGroup Header="{ll:Str 'Submit'}" HeaderPadding="10,0,10,0" HeaderHeight="20" Orientation="Horizontal"
                    Margin="0,2,0,0" Padding="1" FontSize="16" ToolTip="{ll:Str Do you want to upload the current game archive?}">
                <CheckBox x:Name="tUpload" Content="{ll:Str 'Upload Game Saved'}" Margin="5,0,0,0" IsChecked="True"
                        Click="tUpload_Click" />
            </pu:FormGroup>
            <pu:FormGroup Header="{ll:Str 'Contact'}" HeaderPadding="10,0,10,0" HeaderHeight="20" Orientation="Horizontal"
                    Margin="0,2,0,0" Padding="1" FontSize="16" ToolTip="{ll:Str 'Provide contact information for feedback, or not'}">
                <TextBox x:Name="tContact" pu:TextBoxHelper.Watermark="{ll:Str 'Provide contact information for feedback, or not\&#13;eg:QQ430081239'}"
                        AcceptsReturn="True" MaxHeight="44" />
            </pu:FormGroup>
            <Label
                    Content="{ll:Str 'OR,Contact\&#13;B: VPet-Simulator \&#13;Email: service@exlb.net \&#13;Github: https://github.com/LorisYounger/VPet'}"
                    Background="{x:Null}" />
            <Button x:Name="btn_Report" Content="{ll:Str 'Submit'}" Margin="10,10,0,10" FontSize="16"
                    Background="{DynamicResource DARKPrimary}" BorderThickness="1" pu:ButtonHelper.CornerRadius="5"
                    BorderBrush="{DynamicResource DARKPrimaryDarker}" Foreground="{DynamicResource DARKPrimaryText}"
                    Padding="2" Click="btn_upload" />
        </StackPanel>
        <Grid x:Name="gridLoading" Visibility="Collapsed">
            <pu:Spin GlyphSize="14" SpinStyle="Classic" GlyphBrush="{DynamicResource DARKPrimaryTrans}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Height="100" Width="100" />
            <ProgressBar x:Name="pgload" VerticalAlignment="Center" Height="20" BorderThickness="2"
                    pu:ProgressBarHelper.CornerRadius="4" Foreground="{DynamicResource ProgressBarForeground}"
                    Background="{DynamicResource Secondary}" Value="60" BorderBrush="{DynamicResource DARKPrimary}"
                    Maximum="120" pu:ProgressBarHelper.IsPercentVisible="True" Margin="20,150,20,0" />
        </Grid>
    </Grid>
</pu:WindowX>
