<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VPet.Cognition.Voice</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>VPet.Cognition.Voice</AssemblyTitle>
    <Description>Voice providers for VPet cognition: Whisper STT + Piper/Kokoro TTS (offline-first).</Description>
    <Product>VPet.Cognition.Voice</Product>
    <Copyright>Copyright (c) 2026</Copyright>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VPet.Cognition.Domain\VPet.Cognition.Domain.csproj" />
  </ItemGroup>

</Project>