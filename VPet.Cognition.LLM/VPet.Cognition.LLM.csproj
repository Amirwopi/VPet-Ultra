<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VPet.Cognition.LLM</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>VPet.Cognition.LLM</AssemblyTitle>
    <Description>LLM provider implementations for VPet cognition (Ollama, OpenAI-compatible).</Description>
    <Product>VPet.Cognition.LLM</Product>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VPet.Cognition.Domain\VPet.Cognition.Domain.csproj" />
  </ItemGroup>

</Project>